# "development" ou "production" -- em produção, ativa o cookie de
# autenticação com secure=True (exige HTTPS)
AMBIENTE=development

# Banco de dados
# 27018 (não 27017) -- a porta exposta do Mongo no docker-compose foi
# mudada pra evitar conflito com um Mongo nativo rodando no host.
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=conecta_empresas

# Postgres (infra nova, migração em andamento -- convive com o Mongo até
# os repositories serem migrados um por um). 5433 (não 5432) pelo mesmo
# motivo da porta do Mongo acima: evitar conflito com um Postgres local.
DATABASE_URL=postgresql+asyncpg://conecta:conecta@localhost:5433/conecta_empresas

# Autenticação
JWT_SECRET_KEY=troque-por-uma-chave-secreta-forte
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Pagamento (preencher quando iniciar a integração)
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# URL pública da aplicação (link do ngrok em dev, ou o domínio real em produção)
PUBLIC_BASE_URL=http://localhost:8000

# E-mail (Gmail) -- usado no "esqueci minha senha". Se deixar em branco, o
# link aparece no terminal em vez de ser enviado de verdade (bom pra testar).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
